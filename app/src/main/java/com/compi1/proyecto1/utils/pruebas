/* --- PRUEBA 1: MATEMATICAS Y LOGICA --- */
$ Declaracion de variables basicas
number base = 10.5
number altura = 4
number area = (base * altura) / 2

$ Evaluacion de condicional (Area deberia ser 21)
IF (area > 20 && base == 10.5) {
    SECTION [
        elements: {
            TEXT [
                content: "El area es mayor a 20 y las mates funcionan @[:)]",
                styles [
                    "color": GREEN,
                    "text size": 20,
                    "font family": SANS_SERIF
                ]
            ]
        }
    ]
} ELSE IF (area < 20) {
    SECTION [
        elements: {
            TEXT [ content: "Esto no deberia imprimirse", styles [ "color": RED ] ]
        }
    ]
} ELSE {
    SECTION [
        elements: {
            TEXT [ content: "Tampoco esto", styles [ "color": RED ] ]
        }
    ]
}


/* --- PRUEBA 2: CICLOS Y SECCIONES --- */
SECTION [
    width: 300,
    height: 400,
    orientation: VERTICAL,
    styles [ "background color": #E0E0E0 ],
    elements: {
        TEXT [ content: "Iniciando ciclo WHILE:" ]
    }
]

number contador = 1
WHILE (contador <= 3) {
    SECTION [
        elements: {
            TEXT [ content: "Iteracion While numero @[:star:]" ]
        }
    ]
    contador = contador + 1
}

SECTION [
    elements: {
        TEXT [ content: "Iniciando ciclo FOR de rango:" ]
    }
]

FOR (i in 1 .. 2) {
    SECTION [
        elements: {
            TEXT [ content: "Iteracion For Rango @[:^^:]" ]
        }
    ]
}



